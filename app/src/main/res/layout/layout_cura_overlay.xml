<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="top|end"
    android:orientation="horizontal">

    <!-- Speech Balloon (Toggled on tap or auto-triggered every 5m) -->
    <LinearLayout
        android:id="@+id/layoutBalloon"
        android:layout_width="244dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_tactical_balloon"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 1. 常時表示: ヘッダー (:: CURA // TIME [通常帯/深夜制限]) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBalloonHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text=":: CURA // TIME"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBalloonRuleTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="[通常帯]"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 1. 常時表示: 対象アプリ名 + 画面連続使用時間 + [▼詳細] トグル -->
        <LinearLayout
            android:id="@+id/layoutBalloonSummaryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/tvBalloonAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="82dp"
                android:text="Chrome"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBalloonContinuousDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="画面連続: 0秒"
                android:textColor="@color/accent_lime"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBalloonDetailToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
                android:text="[▼詳細]"
                android:textColor="@color/accent_cyan"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. タップで開閉する詳細データ枠 (初期状態は GONE) -->
        <LinearLayout
            android:id="@+id/layoutBalloonDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/bg_surface"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvBalloonAppDayTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="1日のアプリ累計: 0秒"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBalloonPhoneDayTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="1日のスマホ累計: 0秒"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBalloonBudgetRemaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="1時間の残枠: 30分"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvBalloonAlertWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="連続上限（30分）超過"
                android:textColor="@color/accent_crimson"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 1. 常時表示: キャラクターのセリフ枠 -->
        <TextView
            android:id="@+id/tvBalloonDialogue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@color/bg_surface"
            android:paddingHorizontal="7dp"
            android:paddingVertical="5dp"
            android:text="えへへ、呼びましたか？無理せずマイペースでいきましょうねっ！"
            android:textColor="@color/text_primary"
            android:textSize="11.5sp" />

        <!-- 1. 常時表示: 30秒マイクロアクション（画面ブロック）ボタン -->
        <Button
            android:id="@+id/btnBalloonBlock30s"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/accent_mint"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingVertical="0dp"
            android:text="1回だけ深呼吸する (30秒)"
            android:textColor="@color/bg_void"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- 2. 22:00〜04:00 限定表示: 今日は眠る（1時間画面ブロック）ボタン -->
        <Button
            android:id="@+id/btnBalloonSleep1h"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:backgroundTint="@color/accent_pastel_cyan"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingVertical="0dp"
            android:text="今日は眠る (1時間ブロック)"
            android:textColor="@color/bg_void"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- DesktopMate Style: Peeking Chibi Cura on Right Screen Edge -->
    <FrameLayout
        android:id="@+id/layoutSideHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <ImageView
            android:id="@+id/ivCuraPeeking"
            android:layout_width="wrap_content"
            android:layout_height="115dp"
            android:layout_gravity="end|top"
            android:adjustViewBounds="true"
            android:contentDescription="Cura"
            android:scaleType="fitEnd"
            android:src="@drawable/cura_peeking_chibi" />
    </FrameLayout>

</LinearLayout>
