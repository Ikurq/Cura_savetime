<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_void"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- 1. Fixed Status Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="CURA_OS // TIME_DEFENSE_MONITOR"
            android:textColor="@color/accent_cyan"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/bg_surface"
            android:fontFamily="monospace"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="更新確認"
            android:textColor="@color/text_secondary"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/bg_surface"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="● ACTIVE"
            android:textColor="@color/accent_lime"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_frame" />

    <!-- Scrollable Tab Content Area -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Permission Banners (Shown only when permissions are missing) -->
            <LinearLayout
                android:id="@+id/layoutPermissionBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tactical_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/permission_required_title"
                    android:textColor="@color/accent_crimson"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/permission_required_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnGrantPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/accent_crimson"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/grant_permission"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutOverlayPermissionBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tactical_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text=":: OVERLAY_PERMISSION_REQUIRED"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="画面端のCuraと吹き出しを表示するために「他のアプリの上に重ねて表示」を許可してください。"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnGrantOverlayPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/accent_cyan"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="重ねて表示を許可する"
                    android:textColor="@color/bg_void"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAccessibilityBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tactical_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/accessibility_required_title"
                    android:textColor="@color/accent_amber"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/accessibility_required_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnGrantAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/accent_amber"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/grant_accessibility"
                    android:textColor="@color/bg_void"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- TAB 1: HOME / DASHBOARD (ファーストビュー最優先)              -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/tabContainerHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- 1. Hero Section: Today's Total Usage -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_tactical_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="本日の利用時間"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBufferStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="[ 監視中 ]"
                            android:textColor="@color/accent_lime"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Large Bold Total Usage Readout -->
                    <TextView
                        android:id="@+id/tvTodayTotalTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:text="00:00:00"
                        android:textColor="@color/text_primary"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <!-- Active App Sub-row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvActiveAppName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="現在: 待機中"
                            android:textColor="@color/accent_cyan"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvContinuousTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="00:00:00"
                            android:textColor="@color/accent_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnExcludeCurrentApp"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="@color/bg_surface"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="0dp"
                            android:text="除外"
                            android:textColor="@color/accent_amber"
                            android:textSize="9.5sp"
                            android:visibility="gone" />
                    </LinearLayout>


                </LinearLayout>

                <!-- 2. Simplified 24H Trend Graph Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_tactical_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="利用タイムライン"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnZoom24h"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="@color/bg_surface"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="40dp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="0dp"
                            android:text="24H"
                            android:textColor="@color/accent_cyan"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnZoom6h"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="@color/bg_surface"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="36dp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="0dp"
                            android:text="6H"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnZoom1h"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="@color/bg_surface"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="36dp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="0dp"
                            android:text="1H"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnZoom15m"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:backgroundTint="@color/bg_surface"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="40dp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="0dp"
                            android:text="15M"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTimelineInspector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:background="@color/bg_surface"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="5dp"
                        android:text="グラフをタップ・なぞると該当時刻のアプリと利用時間を表示します"
                        android:textColor="@color/accent_lime"
                        android:textSize="10.5sp" />

                    <jp.cura.savetime.ui.TimelineGraphView
                        android:id="@+id/timelineGraphView"
                        android:layout_width="match_parent"
                        android:layout_height="175dp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:id="@+id/layoutTimelineLegend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- 3. Top Usage Apps Card (Top 5 with Comparative Bar) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_tactical_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="利用時間ランキング"
                            android:textColor="@color/accent_lime"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="タップで制限設定"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutRankingList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- 4. Assistant Section: Character Dialogue & Quick Relaxation Actions -->
                <LinearLayout
                    android:id="@+id/layoutAssistantCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_tactical_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="CURA // アシスタント"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="タップでセリフ更新"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Speech Bubble Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/bg_surface"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="Cura Assistant"
                            android:scaleType="fitCenter"
                            android:src="@drawable/cura_peeking_chibi" />

                        <TextView
                            android:id="@+id/tvHeroCuraMessage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingExtra="3dp"
                            android:text="マスター、今日もスマホの使いすぎに気をつけて一緒にがんばりましょうねっ！"
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>


                </LinearLayout>
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- TAB 2: DETAILED LOGS (生ログ抑制・アコーディオン・行タップ操作) -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/tabContainerLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tactical_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text=":: ACTIVITY_LOGS // アプリ切り替え履歴"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLogSummaryBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="行タップで設定"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Micro-switch (<5s) Accordion Banner -->
                    <LinearLayout
                        android:id="@+id/layoutMicroLogAccordion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="6dp"
                        android:background="@color/bg_surface"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvMicroLogHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="▸ その他の短時間切り替え（5秒未満）"
                            android:textColor="@color/accent_amber"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layoutMicroLogList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Clean Main Logs List (>= 5s) -->
                    <LinearLayout
                        android:id="@+id/layoutTimelineList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- TAB 3: BLOCK & LIMIT SETTINGS (制限・透過・除外・セリフ設定)  -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/tabContainerSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Daemon Toggle & Quick Block Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_tactical_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text=":: DEFENSE_DAEMON // 常駐監視サービス"
                                android:textColor="@color/accent_cyan"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="毎正時に自動リセット・5分ごとに通知"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchMonitorDaemon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Game / Ghost Mode Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_tactical_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text=":: GAME_GHOST_MODE // 半透明・タッチ透過"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnAddGhostApp"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:backgroundTint="@color/accent_cyan"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:text="+ アプリ追加"
                            android:textColor="@color/bg_void"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ゲームカテゴリのアプリを自動で半透明・透過にする"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAutoGameGhost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutGhostAppsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Exclusions Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_tactical_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text=":: EXCLUSIONS // 監視除外アプリ"
                            android:textColor="@color/accent_amber"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnAddExclusion"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:backgroundTint="@color/accent_amber"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:text="+ アプリ追加"
                            android:textColor="@color/bg_void"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutExclusionsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- 5-Minute Dialogue & AI Prompt Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_tactical_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="monospace"
                        android:text=":: CURA_5MIN_DIALOGUE // セリフ枠・AI連携"
                        android:textColor="@color/accent_lime"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCopyAiPrompt"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/bg_surface"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="AIプロンプトをコピー"
                            android:textColor="@color/accent_cyan"
                            android:textSize="10.5sp" />

                        <Button
                            android:id="@+id/btnEditDialogueJson"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/accent_lime"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="セリフJSON貼付・編集"
                            android:textColor="@color/bg_void"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 凸型フローティング・ボトムナビゲーション (Bulge Navigation / 3層構造) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Layer 1: 移動する突起サークル -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/navBulgeCircle"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="65dp"
            app:cardBackgroundColor="@color/nav_bar_color"
            app:cardCornerRadius="35dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <!-- Layer 2: メインフローティングバー -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="30dp"
            android:background="@drawable/bg_nav_base"
            android:elevation="0dp" />

        <!-- Layer 3: 操作ロジック本体 -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            style="@style/BulgeBottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="20dp"
            android:translationZ="20dp"
            app:backgroundTint="@android:color/transparent"
            app:itemIconTint="@color/selector_nav_color"
            app:itemPaddingBottom="16dp"
            app:itemPaddingTop="44dp"
            app:itemTextColor="@color/selector_nav_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </FrameLayout>

</LinearLayout>
