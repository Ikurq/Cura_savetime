<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="top|end"
    android:orientation="horizontal">

    <!-- Speech Balloon (Toggled on tap or auto-triggered every 5m) -->
    <LinearLayout
        android:id="@+id/layoutBalloon"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_tactical_balloon"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBalloonHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text=":: CURA // TIME"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBalloonRuleTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="[通常帯]"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBalloonAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="YouTube"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBalloonContinuousDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="連続 15分 経過"
            android:textColor="@color/accent_crimson"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBalloonDialogue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/bg_surface"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:text="[5分枠] メッセージ"
            android:textColor="@color/text_primary"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvBalloonBudgetRemaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1時間の残枠: 15分"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvBalloonAlertWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⚠️ 休憩を取りましょう"
            android:textColor="@color/accent_crimson"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- DesktopMate Style: Peeking Chibi Cura on Right Screen Edge -->
    <FrameLayout
        android:id="@+id/layoutSideHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <ImageView
            android:id="@+id/ivCuraPeeking"
            android:layout_width="wrap_content"
            android:layout_height="115dp"
            android:layout_gravity="end|top"
            android:adjustViewBounds="true"
            android:contentDescription="Cura"
            android:scaleType="fitEnd"
            android:src="@drawable/cura_peeking_chibi" />
    </FrameLayout>

</LinearLayout>
