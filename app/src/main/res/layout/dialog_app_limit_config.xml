<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/accent_cyan"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="@string/app_limit_label_limit_time"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerLimitMinutes"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_tactical_card"
        android:paddingHorizontal="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="@string/app_limit_label_block_duration"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerBlockDuration"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_tactical_card"
        android:paddingHorizontal="12dp" />

    <TextView
        android:id="@+id/tvConfigSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1500F0FF"
        android:padding="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
